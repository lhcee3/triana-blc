# .env - Minimal setup for TouristID contract
# Copy this to your .env file to get started

# ===== LOCAL DEVELOPMENT (No external setup needed) =====
# These work with Hardhat's built-in network

# Enable gas reporting in tests (optional)
REPORT_GAS=true

# ===== TESTNET DEPLOYMENT (Only add these if you want to deploy to real testnet) =====
# Uncomment and fill these ONLY when you're ready to deploy to Sepolia

# Your test wallet private key (64 characters, no 0x prefix)
# PRIVATE_KEY=

# Free RPC URL from Infura (create account at infura.io)
# SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# ===== CONTRACT VERIFICATION (Optional - only for public verification) =====
# Get from etherscan.io if you want to verify contracts publicly
# ETHERSCAN_API_KEY=

# ===== NOTES =====
# - You can test and deploy locally without ANY of the above URLs
# - Only uncomment the PRIVATE_KEY and SEPOLIA_URL when you want real testnet deployment
# - Local development works perfectly with just REPORT_GAS=true